<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="4">
  <Content>
    <Paragraph Type="Action"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">FADE IN:</Text></Paragraph>
    <Paragraph Number="1" Type="Scene Heading"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EXT. MÖKKI JÄRVEN RANNALLA - AAMU</Text></Paragraph>
    <Paragraph Type="Action"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Sumu nousee järveltä. ÄITI (60) kantaa vesisankoa laiturilta kohti saunaa – hitaasti, </Text><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">varovasti</Text><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">.</Text></Paragraph>
    <Paragraph Type="Action"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Laiturin päässä istuu </Text><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">ÖRKKI</Text><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">, naapurin koira.</Text></Paragraph>
    <Paragraph Type="Character"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">ÄITI</Text></Paragraph>
    <Paragraph Type="Parenthetical"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">(huutaa)</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Örkki! Tule pois sieltä!</Text></Paragraph>
    <Paragraph Type="Character"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EERO (O.S.)</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Se ei kuuntele sua, äiti.</Text></Paragraph>
    <Paragraph Number="2" Type="Scene Heading"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">INT. MÖKKI - KEITTIÖ - JATKUVA</Text></Paragraph>
    <Paragraph Type="Action"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EERO (35) kaataa kahvia. Pöydällä on </Text><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">vanha valokuva</Text><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">.</Text></Paragraph>
    <Paragraph Type="Character"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EERO</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">I'm only staying for the weekend. "Just two days," I said.</Text></Paragraph>
    <Paragraph Type="Character"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">ÄITI</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Sanoit niin viime kesänäkin.</Text></Paragraph>
    <Paragraph Type="Transition"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">CUT TO:</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">INT. SAUNA - ILTA</Text></Paragraph>
    <Paragraph Type="Action"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">KIUAS SIHISEE.</Text></Paragraph>
    <Paragraph Type="Character"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">ÄITI</Text></Paragraph>
    <Paragraph Type="Parenthetical"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">(hiljaa)</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Muistatko, kun isä rakensi tämän saunan? Sinä olit silloin niin pieni, että istuit koko ajan alalauteella ja lasket kiviä. Isä sanoi, että jokainen kivi on oma tarinansa. Yksi tuli Lapista, toinen Ahvenanmaalta, kolmas siitä rannasta, jossa me uitiin joka kesä. Hän kirjoitti niiden nimet vihkoon, ja se vihko on vieläkin tuolla kaapissa. Minä en ole avannut sitä sen jälkeen. En ole halunnut. Mutta nyt kun sinä olet täällä, ajattelin, että voisimme lukea sen yhdessä. Ehkä huomenna. Ehkä vasta sitten, kun sumu on noussut ja järvi on taas tyyni. Ei sillä ole kiire. Ei enää.</Text></Paragraph>
    <Paragraph Type="Character"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EERO</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Huomenna.</Text></Paragraph>
    <Paragraph Type="Action" Alignment="Center"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">LOPPU</Text></Paragraph>
    <Paragraph Type="Scene Heading" StartsNewPage="Yes"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EXT. LAITURI - YÖ</Text></Paragraph>
    <Paragraph Type="Action"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Kuu heijastuu veteen.</Text></Paragraph>
    <Paragraph Type="Character"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">BRICK</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Screw retirement.</Text></Paragraph>
    <Paragraph Type="Character"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">STEEL</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Hold on a sec.</Text></Paragraph>
    <Paragraph Type="Action"><Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">FADE OUT.</Text></Paragraph>
  </Content>
